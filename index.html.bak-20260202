<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // For local debug use: python3 -m http.server 8000 (http://localhost:8000)
        const AppTitleStr = "Jnrobox Radio YouTube";
        const AppVersionStr = "20260202";
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jnrobox Radio YouTube</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');
        body { background: #020617; color: #f8fafc; font-family: 'Inter', sans-serif; overflow: hidden; }
        .glass { background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); }
        .bar { transition: height 0.2s ease; width: 4px; border-radius: 99px; }
        #player { display: none; }
        .marquee-container { width: 100%; overflow: hidden; white-space: nowrap; }
        .marquee { display: inline-block; padding-left: 100%; animation: marquee 15s linear infinite; }
        @keyframes marquee { 0% { transform: translate(0, 0); } 100% { transform: translate(-100%, 0); } }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
        .pulse-text { animation: pulse 2s infinite; color: #22d3ee; }
        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        .playlist-item.active { color: #22d3ee; background: rgba(34, 211, 238, 0.1); border-left: 3px solid #22d3ee; }
        input[type=range] { -webkit-appearance: none; background: transparent; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; height: 12px; width: 12px; border-radius: 50%; background: #94a3b8; cursor: pointer; margin-top: -4px; }
        input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 4px; background: #1e293b; border-radius: 2px; }
        .btn-active { color: #22d3ee; filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.6)); }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen">

    <div class="glass p-8 rounded-[2.5rem] w-80 shadow-2xl border border-white/10 flex flex-col h-[650px]">
        <div class="text-center">
            <div id="visualizer" class="flex justify-center items-end space-x-1 h-8 mb-4">
                <div class="bar bg-cyan-500 h-2"></div><div class="bar bg-blue-500 h-2"></div><div class="bar bg-indigo-500 h-2"></div><div class="bar bg-purple-500 h-2"></div><div class="bar bg-pink-500 h-2"></div>
            </div>
            <div class="flex justify-center mb-2">
                <span class="text-[7px] bg-cyan-500/20 text-cyan-400 px-2 py-0.5 rounded-full font-bold tracking-widest border border-cyan-500/30">DATA SAVER ACTIVE</span>
            </div>
            <h1 id="info-tag" class="text-[9px] font-black tracking-[0.3em] text-gray-500 uppercase mb-2">Player info</h1>
            <div class="h-8 marquee-container flex items-center mb-4">
                <p id="track-title" class="marquee text-md font-bold text-white tracking-tight">Player is ready</p>
            </div>
        </div>

        <div class="px-2 mb-4">
            <input type="range" id="progress-bar" min="0" max="100" value="0" oninput="seek(this.value)" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-cyan-400 mb-1">
            <div class="flex justify-between text-[9px] font-mono text-gray-500">
                <span id="current-time">0:00</span>
                <span id="total-duration">0:00</span>
            </div>
        </div>

        <div class="flex items-center justify-between px-2 mb-6">
            <button onclick="toggleShuffle()" id="shuffle-btn" class="text-gray-500 hover:text-white transition active:scale-90">
                <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.45 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></svg>
            </button>
            <button onclick="playPrev()" class="text-gray-400 hover:text-white transition active:scale-90"><svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18V6h2v12H6zm3.5-6L18 18V6l-8.5 6z"/></svg></button>
            <button onclick="togglePlay()" id="play-btn" class="bg-white text-black p-4 rounded-full hover:scale-110 transition active:scale-95 shadow-lg"><svg id="play-icon" width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path id="icon-path" d="M8 5v14l11-7z"/></svg></button>
            <button onclick="playNext()" class="text-gray-400 hover:text-white transition active:scale-90"><svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>
            <div class="w-[18px]"></div>
        </div>

        <div class="flex items-center space-x-3 px-4 mb-8">
            <svg class="text-gray-500" width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
            <input type="range" id="volume-slider" min="0" max="100" value="50" oninput="changeVolume(this.value)" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer">
        </div>

        <div class="flex-grow overflow-hidden flex flex-col">
            <div class="flex justify-between items-center mb-3 px-2">
                <h2 class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Station Feed</h2>
                <button onclick="resetAll()" class="text-[8px] text-gray-600 hover:text-red-400">RESET PLAYER</button>
            </div>
            <div id="playlist-container" class="flex-grow overflow-y-auto custom-scroll space-y-2 pr-2"></div>
        </div>
        <div id="player"></div>
    </div>

    <script>
        document.title = AppTitleStr;
        console.log(AppTitleStr + ' (ver. ' + AppVersionStr + ')');

        const infoEl = document.getElementById('info-tag');
        infoEl.innerText = AppTitleStr + '\nver. ' + AppVersionStr;
        //infoEl.classList.add('pulse-text');
        
        const PLAYLIST_ID = 'PL01N4uJROxb9EpAmC4yrRug0Mv9TIpu84'; 
        let player, isPlaying = false, isShuffled = localStorage.getItem('radio_shuffle') === 'true';
        let vizInterval, progressInterval, needsResume = false;

        let trackCache = JSON.parse(localStorage.getItem('radio_titles')) || {};
        let savedVolume = localStorage.getItem('radio_volume') || 50;
        let lastPos = JSON.parse(localStorage.getItem('radio_last_pos')) || null;

        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);

        function onYouTubeIframeAPIReady() {
            player = new YT.Player('player', {
                height: '0', width: '0',
                playerVars: { 
                    'listType': 'playlist', 
                    'list': PLAYLIST_ID, 
                    'enablejsapi': 1,
                    'vq': 'small' // Suggest lowest quality to start
                },
                events: { 'onReady': onPlayerReady, 'onStateChange': onPlayerStateChange }
            });
        }

        function onPlayerReady(event) {
            player.setVolume(savedVolume);
            document.getElementById('volume-slider').value = savedVolume;
            player.setShuffle(isShuffled);
            updateShuffleUI();
            
            if (lastPos && lastPos.index !== undefined) {
                needsResume = true;
                player.cuePlaylist({
                    listType: 'playlist', list: PLAYLIST_ID,
                    index: lastPos.index, startSeconds: lastPos.time
                });
                const titleEl = document.getElementById('track-title');
                titleEl.innerText = "TAP TO RESUME SESSION";
                titleEl.classList.add('pulse-text');
                window.addEventListener('click', handleFirstInteraction, { once: true });
            } else {
                player.cuePlaylist({ listType: 'playlist', list: PLAYLIST_ID });
            }
            setTimeout(loadPlaylistUI, 1500);
        }

        function handleFirstInteraction() {
            document.getElementById('track-title').classList.remove('pulse-text');
            player.playVideo();
        }

        function onPlayerStateChange(event) {
            if (event.data == YT.PlayerState.PLAYING) {
                // FORCE LOW BITRATE (144p)
                if (event.target.setPlaybackQuality) {
                    event.target.setPlaybackQuality('small');
                }

                setPlayState(true);
                if (needsResume && lastPos) {
                    player.seekTo(lastPos.time, true);
                    needsResume = false; 
                }
                const data = player.getVideoData();
                if (data.video_id) {
                    trackCache[data.video_id] = data.title;
                    localStorage.setItem('radio_titles', JSON.stringify(trackCache));
                }
                document.getElementById('track-title').innerText = data.title;
                updateListUI(player.getPlaylistIndex(), data.title);
                startTimers();
            } else if (event.data == YT.PlayerState.PAUSED) {
                setPlayState(false);
                stopTimers();
            }
        }

        function toggleShuffle() {
            isShuffled = !isShuffled;
            localStorage.setItem('radio_shuffle', isShuffled);
            if(player) {
                player.setShuffle(isShuffled);
                player.playVideoAt(player.getPlaylistIndex());
            }
            updateShuffleUI();
            setTimeout(loadPlaylistUI, 800);
        }

        function updateShuffleUI() {
            const btn = document.getElementById('shuffle-btn');
            isShuffled ? btn.classList.add('btn-active') : btn.classList.remove('btn-active');
        }

        function setPlayState(playing) {
            isPlaying = playing;
            document.getElementById('icon-path').setAttribute('d', playing ? 
                'M6 19h4V5H6v14zm8-14v14h4V5h-4z' : 'M8 5v14l11-7z');
        }

        function updateListUI(activeIndex, title) {
            document.querySelectorAll('.playlist-item').forEach((el, idx) => {
                el.classList.remove('active', 'text-white');
                if (idx === activeIndex) {
                    el.classList.add('active', 'text-white');
                    const span = el.querySelector('.track-name');
                    if(span) { span.innerText = title; span.classList.remove('italic'); }
                }
            });
        }

        function loadPlaylistUI() {
            const list = player.getPlaylist();
            const container = document.getElementById('playlist-container');
            if (!list) return;
            container.innerHTML = '';
            list.forEach((id, index) => {
                const item = document.createElement('div');
                item.className = `playlist-item cursor-pointer p-2 pr-4 rounded-xl text-xs text-gray-400 hover:bg-white/5 transition flex items-center space-x-3`;
                item.onclick = () => { needsResume = false; player.playVideoAt(index); };
                const title = trackCache[id] || `Track ${id}`;
                const thumbUrl = `https://img.youtube.com/vi/${id}/mqdefault.jpg`;
                item.innerHTML = `
                    <div class="relative w-10 h-10 flex-shrink-0">
                        <img src="${thumbUrl}" class="w-full h-full object-cover rounded-lg border border-white/10 opacity-80">
                    </div>
                    <div class="overflow-hidden">
                        <p class="track-name truncate ${trackCache[id] ? '' : 'italic font-mono opacity-60'}">${title}</p>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function startTimers() {
            clearInterval(vizInterval); clearInterval(progressInterval);
            vizInterval = setInterval(() => {
                document.querySelectorAll('.bar').forEach(bar => {
                    bar.style.height = Math.floor(Math.random() * 25 + 5) + 'px';
                });
            }, 150);
            progressInterval = setInterval(() => {
                if(player.getCurrentTime && player.getDuration) {
                    const curr = player.getCurrentTime();
                    localStorage.setItem('radio_last_pos', JSON.stringify({
                        index: player.getPlaylistIndex(),
                        time: Math.floor(curr)
                    }));
                    document.getElementById('progress-bar').value = (curr / player.getDuration()) * 100;
                    document.getElementById('current-time').innerText = formatTime(curr);
                    document.getElementById('total-duration').innerText = formatTime(player.getDuration());
                }
            }, 1000);
        }

        function stopTimers() { clearInterval(vizInterval); clearInterval(progressInterval); }
        function formatTime(s) { const m = Math.floor(s / 60); const sec = Math.floor(s % 60); return m + ":" + (sec < 10 ? "0" + sec : sec); }
        function togglePlay() { player.getPlayerState() === 1 ? player.pauseVideo() : player.playVideo(); }
        function playNext() { needsResume = false; player.nextVideo(); }
        function playPrev() { needsResume = false; player.previousVideo(); }
        function seek(val) { if(player.getDuration) player.seekTo((val / 100) * player.getDuration(), true); }
        function changeVolume(v) { if(player) player.setVolume(v); localStorage.setItem('radio_volume', v); }
        function resetAll() { localStorage.clear(); location.reload(); }
    </script>
</body>
</html>
